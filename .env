# Configuración de Base de Datos MySQL (MySQL Workbench)
# Cambia 'root' y 'tu_contraseña' por tus credenciales de MySQL Workbench
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=adopciones_db

# URL directa de MySQL para SQLAlchemy (PyMySQL)
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/adopciones_db?charset=utf8mb4

# Si MySQL no está corriendo o quieres usar SQLite de prueba local, puedes cambiar a:
# USE_SQLITE_FALLBACK=true
USE_SQLITE_FALLBACK=true

# Seguridad y Autenticación JWT
JWT_SECRET=super_secret_jwt_key_nubira_weather_2026_adopciones
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS / Frontend URLs (separados por coma)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
